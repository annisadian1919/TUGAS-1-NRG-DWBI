        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var raw_phone_s2 = (hp != null) ? hp : "";
var no_hp_bersih = replace(raw_phone_s2, "[^0-9]", "");

if (indexOf(no_hp_bersih, "08") == 0) {
    no_hp_bersih = "628" + substr(no_hp_bersih, 2);
} else if (indexOf(no_hp_bersih, "8") == 0) {
    no_hp_bersih = "62" + no_hp_bersih;
}</jsScript_script>
