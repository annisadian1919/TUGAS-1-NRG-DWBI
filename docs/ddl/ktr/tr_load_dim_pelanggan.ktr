        <jsScript_script>// Bersihkan karakter selain angka
var raw_phone = (phone != null) ? phone : "";
var no_hp_bersih = replace(raw_phone, "[^0-9]", "");

// Standarisasi nomor ke awalan 628
if (indexOf(no_hp_bersih, "08") == 0) {
    no_hp_bersih = "628" + substr(no_hp_bersih, 2);
} else if (indexOf(no_hp_bersih, "8") == 0) {
    no_hp_bersih = "62" + no_hp_bersih;
}</jsScript_script>
