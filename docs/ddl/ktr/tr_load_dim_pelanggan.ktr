        <jsScript_script>var status_omnichannel;
if (customer_id != null &amp;&amp; member_no != null) {
    status_omnichannel = "Omnichannel (Web &amp; POS)";
} else if (customer_id != null) {
    status_omnichannel = "Hanya Web";
