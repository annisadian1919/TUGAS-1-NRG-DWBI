        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>   function r2(v){ return Math.round(v*100)/100; }
   var material_no = "P-" + (1000 + Number(product_id));
   var harga_satuan_tanpa_ppn = r2(harga_satuan / 1.11);
   var penjualan_kotor = r2(qty * harga_satuan / 1.11);
   var diskon_nominal = r2(diskon / 1.11);
   var penjualan_bersih = r2(penjualan_kotor - diskon_nominal);
   var fee_marketplace = 0;
   var customer_ref = "" + customer_id;

</jsScript_script>
