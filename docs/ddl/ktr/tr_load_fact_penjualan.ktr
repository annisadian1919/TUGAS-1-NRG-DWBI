    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>  function r2(v){ return Math.round(v*100)/100; }
  var hp = (harga_pokok == null) ? 0 : harga_pokok;
  var harga_pokok_penjualan = r2(qty * hp);
  var margin_kotor = r2(penjualan_bersih - harga_pokok_penjualan - fee_marketplace);
  var no_transaksi = trx_id;
</jsScript_script>
      </jsScript>
    </jsScripts>
