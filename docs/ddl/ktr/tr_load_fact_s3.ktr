        <jsScript_script>var t = null;
var waktu_wib = null;
var waktu_key = null;
if (paid_at != null &amp;&amp; paid_at.indexOf("test value") === -1 &amp;&amp; paid_at.length >= 10) {
    t = str2date(paid_at, "yyyy-MM-dd'T'HH:mm:ss'Z'");
    waktu_wib = dateAdd(t, "h", 7);
    waktu_key = str2num(date2str(waktu_wib, "yyyyMMdd"));
}
var material_no = "P-UNKNOWN"; 
if (seller_sku != null) {
    material_no = "P-" + replace(seller_sku, "^[A-Za-z]+", "");
}
var kode_kanal = channel;
var kotor_inkl = 0;
if (price != null &amp;&amp; qty != null) {
    kotor_inkl = price * qty;
}</jsScript_script>
